# Generated from pyproject.toml by tools/pyproject-deps.py (CI and Docker only)
requirements.txt
requirements-docs.txt
requirements-ci.txt
requirements-dev.txt

# Resolved once per release by .github/workflows/docker-build.yml and handed to
# every architecture build. Committing it would pin the images to a stale
# resolution while pyproject.toml deliberately pins nothing.
constraints.txt

# Project-generated metadata
BUILD_INFO

