# App data (mounted as a volume)
*.db
data/

# Build / packaging artifacts
*.egg-info/
.eggs/
build/
dist/

# Caches
.eslintcache
.mypy_cache/
.pytest_cache/
.ruff_cache/
.stylelintcache
__pycache__/
**/__pycache__/

# Editor / OS
.DS_Store
.idea/
.vscode/

# Environment and secrets
.env
.env.*
!.env.example

# Git / repo metadata (CI workflows, README assets — not needed at runtime).
# pyproject.toml, CHANGELOG.md and LICENSE deliberately stay in the context:
# the builder reads dependencies out of the manifest, the runtime stage copies
# it in for app/utils/version.py, and CHANGELOG.md is rendered by the app.
.dockerignore
.gitattributes
.git/
.gitignore
.github/
.trivyignore
README.md

# Documentation: built and published by .github/workflows/docs-build.yml, and
# never read by the running container.
docs/
site/
.mkdocs-cache/

# Local tooling and setup
.claude/settings.local.json
.codex
.kiro/
.omx/
node_modules/
package.json
package-lock.json
setup.conf
tools/

# Tests: the image copies app/ and middleware/ only, so these are pure context.
tests/

# Python
*.py[cod]
**/*.py[cod]
.venv/

# Runtime and development artifacts
*.backup
*.har
*.log
.coverage
.coverage.*
app/static/vendor/wavesurfer/
cookies.txt
coverage.xml
htmlcov/
